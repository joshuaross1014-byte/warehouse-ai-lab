# .env.example - copy to ".env" in this folder, or set these as environment variables.
# Never commit .env. Real environment variables win over this file.

ANTHROPIC_API_KEY=sk-ant-...

# SQL login. Prefer a READ-ONLY login for anything shared.
WMS_USER=
WMS_PASS=
WMS_PROD_SERVER=your-prod-sql-host
WMS_TEST_SERVER=your-test-sql-host
WMS_DATABASE=WMS

# Optional tuning (defaults shown)
# WMS_AGENT_MODEL=claude-opus-5-5
# WMS_AGENT_EFFORT=high
# WMS_AGENT_MAX_ROWS=200
# WMS_AGENT_QUERY_TIMEOUT=60
# WMS_AGENT_DEFAULT_SERVER=prod
# WMS_AGENT_MEMORY_DIR=C:path	omemory-bank   (server names above must match its memory_config.json keys)
# WMS_AGENT_KNOWLEDGE_DIR=C:\path\to\knowledge_mcp
