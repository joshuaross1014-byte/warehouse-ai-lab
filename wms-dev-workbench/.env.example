# Copy to .env (git-ignored) or, better, keep these as Windows user environment variables.
# PROD login (already set in your user env on this laptop; shown here only for a new machine)
# WMS_USER=
# WMS_PASS=

# TEST login (falls back to WMS_USER / WMS_PASS if unset)
# WMS_TEST_USER=
# WMS_TEST_PASS=

# Optional overrides
# WORKBENCH_PROD_SERVER=prod-sql.example.local
# WORKBENCH_TEST_SERVER=test-sql.example.local
# WORKBENCH_DATABASE=WMS
# WORKBENCH_DEFAULT_PROFILE=PROD
# WORKBENCH_PORT=8765
# WORKBENCH_MAX_ROWS=500
# WORKBENCH_QUERY_TIMEOUT=30
# WORKBENCH_ALLOW_WRITES=0      # 1 enables DML on TEST only; PROD can never write
